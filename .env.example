# Copy this file to .env and replace the values for your local Neo4j instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Generate with: python -m scripts.generate_admin_credentials
# Copy its output into your ignored local .env; never commit the plaintext password.
CYBERTRACE_ADMIN_USERNAME=admin
CYBERTRACE_ADMIN_PASSWORD_HASH=
CYBERTRACE_SECRET_KEY=
